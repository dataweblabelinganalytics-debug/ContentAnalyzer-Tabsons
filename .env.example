# URL-encode special characters in username/password, e.g. @ -> %40, # -> %23, / -> %2F.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=ContentAnalyzer
DB_NAME=content_analyzer
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
PORT=5000
