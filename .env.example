# URL-encode special characters in username/password, e.g. @ -> %40, # -> %23, / -> %2F.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=ContentAnalyzer
DB_NAME=content_analyzer
DEFAULT_CHANNEL_GENRE=NEWS
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
PORT=5000
MAX_UPLOAD_BYTES=104857600
COMPARISON_PROCESS_TIMEOUT_SECONDS=1800
JOB_LEASE_SECONDS=600
JOB_POLL_SECONDS=2
JOB_UPLOAD_RETENTION_DAYS=7
JOB_CLEANUP_INTERVAL_SECONDS=3600
